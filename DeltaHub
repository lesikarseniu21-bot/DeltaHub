    if isLocked then
        local LockLabel = Instance.new("TextLabel")
        LockLabel.Size = UDim2.new(1, -40, 1, 0)
        LockLabel.Position = UDim2.new(0, 20, 0, 0)
        LockLabel.BackgroundTransparency = 1
        LockLabel.Text = "⚠️ РАЗДЕЛ ВРЕМЕННО ОТКЛЮЧЕН\n\n" .. (lockReason or "Ожидание подключения сервера.")
