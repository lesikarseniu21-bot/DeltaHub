-- Функция создания вкладок
local Pages = {}
local Buttons = {}

local function CreateTab(tabName, isLocked, lockReason)
    -- Кнопка в меню
    local TabBtn = Instance.new("TextButton")
    TabBtn.Name = tabName .. "Btn"
    TabBtn.Size = UDim2.new(0, 125, 0, 34)
    TabBtn.BackgroundColor3 = Color3.fromRGB(26, 29, 38)
    TabBtn.Text = isLocked and ("🔒 " .. tabName) or tabName
    TabBtn.TextColor3 = isLocked and Color3.fromRGB(110, 115, 130) or Color3.fromRGB(210, 215, 230)
    TabBtn.Font = Enum.Font.GothamMedium
    TabBtn.TextSize = 13
    TabBtn.Parent = SideBar

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 4)
    BtnCorner.Parent = TabBtn

    -- Страница контента
    local Page = Instance.new("Frame")
    Page.Name = tabName .. "Page"
    Page.Size = UDim2.new(1, -24, 1, -24)
    Page.Position = UDim2.new(0, 12, 0, 12)
    Page.BackgroundColor3 = Color3.fromRGB(22, 24, 31)
    Page.Visible = false
    Page.Parent = ContentArea

    local PageCorner = Instance.new("UICorner")
    PageCorner.CornerRadius = UDim.new(0, 6)
    PageCorner.Parent = Page

    -- Если вкладка временно заблокирована (например, из-за API Base)
    if isLocked then
        local LockLabel = Instance.new("TextLabel")
        LockLabel.Size = UDim2.new(1, -40, 1, 0)
        LockLabel.Position = UDim2.new(0, 20, 0, 0)
        LockLabel.BackgroundTransparency = 1
        LockLabel.Text = "⚠️ РАЗДЕЛ ВРЕМЕННО ОТКЛЮЧЕН\n\n" .. (lockReason or "Ожидание подключения сервера.")
        LockLabel.TextColor3 = Color3.fromRGB(220, 140, 60)
        LockLabel.Font = Enum.Font.GothamBold
        LockLabel.TextSize = 14
        LockLabel.TextWrapped = true
        LockLabel.Parent = Page
    end

    Pages[tabName] = Page
    Buttons[tabName] = TabBtn

    -- Логика переключения
    TabBtn.MouseButton1Click:Connect(function()
        for name, p in pairs(Pages) do
            p.Visible = (name == tabName)
            if not isLocked or name ~= tabName then
                Buttons[name].BackgroundColor3 = (name == tabName) and Color3.fromRGB(45, 95, 210) or Color3.fromRGB(26, 29, 38)
            end
        end
    end)

    return Page
end

