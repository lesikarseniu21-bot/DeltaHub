local EffectState = {}
local VisualButtons = {}

local function toggleEffect(name, enabled)
    local fullName = EFFECT_PREFIX .. name

    local oldEffect = Lighting:FindFirstChild(fullName)
    if oldEffect then
        oldEffect:Destroy()
    end

    if not enabled then return end

    if name == "Bloom" then
        create("BloomEffect", {
            Name = fullName,
            Intensity = 0.8,
            Size = 32,
            Threshold = 0.8
        }, Lighting)

    elseif name == "SunRays" then
        create("SunRaysEffect", {
            Name = fullName,
            Intensity = 0.25,
            Spread = 1
        }, Lighting)

    elseif name == "ColorCorrection" then
        create("ColorCorrectionEffect", {
            Name = fullName,
            Brightness = 0.03,
            Contrast = 0.15,
            Saturation = 0.2,
            TintColor = Color3.fromRGB(255, 244, 225)
        }, Lighting)

    elseif name == "Atmosphere" then
        create("Atmosphere", {
            Name = fullName,
            Density = 0.3,
            Offset = 0.1,
            Color = Color3.fromRGB(205, 220, 255),
            Decay = Color3.fromRGB(100, 110, 140),
            Haze = 1.2,
            Glare = 0.15
        }, Lighting)

    elseif name == "Brightness" then
        create("ColorCorrectionEffect", {
            Name = fullName,
            Brightness = 0.12
        }, Lighting)

    elseif name == "Contrast" then
        create("ColorCorrectionEffect", {
            Name = fullName,
            Contrast = 0.2
        }, Lighting)

    elseif name == "Saturation" then
        create("ColorCorrectionEffect", {
            Name = fullName,
            Saturation = 0.3
        }, Lighting)
    end
end

local VisualNames = {
    "Bloom",
    "SunRays",
    "ColorCorrection",
    "Atmosphere",
    "Brightness",
    "Contrast",
    "Saturation"
}

local PremiumVisualNames = {
    "Cinematic",
    "DepthOfField",
    "WarmTone",
    "ColdTone"
}

local PremiumSet = {}
for _, premiumName in ipairs(PremiumVisualNames) do
    PremiumSet[premiumName] = true
end

local IsPremium = false
local PremiumModule = nil -- premium code, delivered by the server only with a valid key

local function refreshVisualText(name)
    local b = VisualButtons[name]
    if not b then return end

    local prefix = PremiumSet[name] and "★ " or ""

    if PremiumSet[name] and not IsPremium then
        b.Text = prefix .. name .. "  [Premium]"
    else
        b.Text = prefix .. name .. (EffectState[name] and "  [ON]" or "  [OFF]")
    end

    animate(b, {BackgroundColor3 = EffectState[name] and C.Accent or C.Button})
end

local function setVisual(name, enabled)
    if PremiumSet[name] then
        if enabled and not PremiumModule then
            return
        end

        EffectState[name] = enabled

        local fullName = EFFECT_PREFIX .. name
        local leftover = Lighting:FindFirstChild(fullName)

        if leftover and not enabled then
            leftover:Destroy()
        end

        if PremiumModule then
            pcall(PremiumModule.toggle, name, enabled, Lighting, EFFECT_PREFIX)
        end

        refreshVisualText(name)
        return
    end

    EffectState[name] = enabled
    toggleEffect(name, enabled)
    refreshVisualText(name)
end

