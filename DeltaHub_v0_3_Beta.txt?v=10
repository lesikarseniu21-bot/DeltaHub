local refreshFriends

local function removeFriend(id)
    Friends[id] = nil
    saveFriends()
    refreshFriends()
end

refreshFriends = function()
    for _, child in ipairs(FriendsRows:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end

    local ids = {}
    for id in pairs(Friends) do
        table.insert(ids, id)
    end

    table.sort(ids, function(a, b)
        local favA, favB = Friends[a].Favorite, Friends[b].Favorite

        if favA ~= favB then
            return favA
        end

        return Friends[a].Name:lower() < Friends[b].Name:lower()
    end)

    ListTab.Text = "Друзья (" .. #ids .. ")"

    if #ids == 0 then
        FriendsHeader.Text = "Пока никого нет. Открой «Найти друга», чтобы добавить."
    else
        FriendsHeader.Text = "Друзей: " .. #ids .. "   (★ — избранные)"
    end

    for order, id in ipairs(ids) do
        local data = Friends[id]
        local online = Players:GetPlayerByUserId(tonumber(id) or 0) ~= nil

        local row = makeRow(
            FriendsRows,
            order,
            data.Name,
            "ID " .. id .. (online and "  •  на этом сервере" or ""),
            online and C.Green or C.Muted
        )

        rowButton(row, "×", -8, 32, C.Panel, function()
            removeFriend(id)
        end)

        local star = rowButton(row, "★", -46, 32, C.Panel, function()
            data.Favorite = not data.Favorite
            saveFriends()
            refreshFriends()
        end)

        star.TextColor3 = data.Favorite and C.Accent or C.Muted
    end
end

