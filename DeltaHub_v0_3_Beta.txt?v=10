local function applyPremiumState(module)
    PremiumModule = module
    IsPremium = module ~= nil

    if not IsPremium then
        for _, premiumName in ipairs(PremiumVisualNames) do
            if EffectState[premiumName] then
                setVisual(premiumName, false)
            end
        end
    end

    for _, premiumName in ipairs(PremiumVisualNames) do
        refreshVisualText(premiumName)
    end

    PremiumVisualsLabel.Text = "Premium эффекты ★"
end

