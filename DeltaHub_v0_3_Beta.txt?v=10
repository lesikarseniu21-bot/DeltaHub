    local DurationOptions = {
        {"1 день", "1d"},
        {"3 дня", "3d"},
        {"1 месяц", "1m"},
        {"3 месяца", "3m"},
        {"Навсегда", "permanent"}
    }

    local durationIndex = 1

    local DurationButton
    DurationButton = button(
        AdminPage,
        "Срок Premium: " .. DurationOptions[1][1],
        function()
            durationIndex = durationIndex % #DurationOptions + 1
            DurationButton.Text = "Срок Premium: " .. DurationOptions[durationIndex][1]
        end
    )

    local DaysInput = input(AdminPage, "Свой срок в днях (необязательно, 0 = навсегда)")
    local TargetInput = input(AdminPage, "Ник или Roblox ID игрока")

    local AdminOutput = label(AdminPage, "Результат появится здесь.", 40, C.Muted)
    AdminOutput.AutomaticSize = Enum.AutomaticSize.Y

    local function showResult(ok, text)
        AdminOutput.Text = text
        AdminOutput.TextColor3 = ok and C.Green or C.Red
    end

    -- Optional extra protection: if you set a secret ADMIN_KEY in Cloudflare,
    -- put it in your own launcher line (not in this script):
    --   getgenv().DeltaHubAdminKey = "your-secret"
    local function adminHeaders()
        local headers = {}

        local ok, secret = pcall(function()
            return getgenv and getgenv().DeltaHubAdminKey
        end)

        if ok and type(secret) == "string" and secret ~= "" then
            headers["X-DeltaHub-AdminKey"] = secret
        end

        return headers
    end

    local function adminCall(method, path, body, onSuccess)
        AdminOutput.Text = "Запрос..."
        AdminOutput.TextColor3 = C.Muted

        task.spawn(function()
            local ok, result = requestAPI(method, path, body, adminHeaders())

            if ok then
                onSuccess(result)
            else
                showResult(false, "Ошибка: " .. tostring(result))
            end
        end)
    end

    -- Duration: the "days" field wins if filled, otherwise the button above.
    -- Returns "<N>d" / "permanent" and a readable label, or nil on bad input.
    local function readDuration()
        local daysText = (DaysInput.Text:gsub("%s+", ""))

        if daysText == "" then
            local option = DurationOptions[durationIndex]
            return option[2], option[1]
        end

        local days = tonumber(daysText)

        if not days or days < 0 or days > 3650 or days % 1 ~= 0 then
            showResult(false, "Срок в днях: целое число от 0 до 3650 (0 = навсегда).")
            return nil
        end

        if days == 0 then
            return "permanent", "навсегда"
        end

        return days .. "d", days .. " дн."
    end

    local function readTarget()
        local target = (TargetInput.Text:gsub("^%s+", ""):gsub("%s+$", ""))

        if target == "" then
            showResult(false, "Введи ник или Roblox ID игрока.")
            return nil
        end

        return target
    end

    local function premiumAction(action)
        local target = readTarget()
        if not target then return end

        local duration = "1d"

        if action == "grant" then
            duration = readDuration()
            if not duration then return end
        end

        adminCall(
            "POST",
            "/v1/admin/premium",
            {action = action, target = target, duration = duration},
            function(result)
                local text = result.message or "Готово"

                if action == "grant" then
                    if result.expiresAt then
                        text = text .. "\nДо: " .. formatExpiry(result.expiresAt)
                    else
                        text = text .. "\nСрок: навсегда"
                    end
                elseif action == "newkey" and result.expiresAt then
                    text = text .. "\nДо: " .. formatExpiry(result.expiresAt)
                end

                if result.key then
                    text = text .. "\nКлюч игрока: " .. result.key
                end

                showResult(true, text)
            end
        )
    end

    -- NEW BUTTON 1: generate a key for a buyer
    button(AdminPage, "Сгенерировать ключ", function()
        local duration, durationLabel = readDuration()
        if not duration then return end

        adminCall(
            "POST",
            "/v1/admin/keys",
            {duration = duration},
            function(result)
                showResult(true,
                    "Ключ: " .. tostring(result.key) ..
                    "\nСрок: " .. durationLabel ..
                    "\nОтправь его покупателю. Срок начнётся после активации."
                )
            end
        )
    end)

    -- NEW BUTTON 2: grant Premium by nickname OR Roblox ID
    button(AdminPage, "Выдать Premium", function()
        premiumAction("grant")
    end)

    button(AdminPage, "Снять Premium", function()
        premiumAction("revoke")
    end)

    button(AdminPage, "Новый ключ игроку (если утёк)", function()
        premiumAction("newkey")
    end)

    button(AdminPage, "Найти пользователя", function()
        local target = readTarget()
        if not target then return end

        adminCall(
            "GET",
            "/v1/admin/user/" .. HttpService:UrlEncode(target),
            nil,
            function(result)
                local lines = {
                    tostring(result.username or "?") .. " (" .. tostring(result.userId) .. ")",
                    "Premium: " .. (result.premium and "да" or "нет")
                }

                if result.premium then
                    table.insert(lines,
                        result.expiresAt
                            and ("Действует до: " .. formatExpiry(result.expiresAt))
                            or "Срок: навсегда"
                    )
                end

                if result.key then
                    table.insert(lines, "Ключ: " .. result.key)
                end

                table.insert(lines, "Сейчас в DeltaHub: " .. (result.online and "да" or "нет"))
                showResult(true, table.concat(lines, "\n"))
            end
        )
    end)

    button(AdminPage, "Список активных пользователей", function()
        adminCall("GET", "/v1/admin/active-users", nil, function(result)
            local users = result.users or {}
            local lines = {"Онлайн: " .. #users}

            for i, user in ipairs(users) do
                if i > 25 then
                    table.insert(lines, "…")
                    break
                end
                table.insert(lines, tostring(user.username) .. " (" .. tostring(user.userId) .. ")")
            end

            showResult(true, table.concat(lines, "\n"))
        end)
    end)

    button(AdminPage, "Список Premium-пользователей", function()
        adminCall("GET", "/v1/admin/premium-list", nil, function(result)
            local users = result.users or {}
            local lines = {"Premium: " .. #users}

            for i, user in ipairs(users) do
